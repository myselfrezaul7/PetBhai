{
  "name": "petbhai",
  "homepage": "https://www.petbhai.com/",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predeploy": "npm run build",
    "dev": "vite",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "server": "cd backend && npm run dev",
    "install:all": "npm install && cd backend && npm install",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "lint": "eslint --max-warnings=0 --no-warn-ignored",
    "lint:all": "eslint \"**/*.{ts,tsx,js,jsx}\" --max-warnings=0 --no-warn-ignored",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,json,md,css,html}'",
    "check:html": "html-validate \"dist/**/*.html\" \"public/**/*.html\"",
    "ci": "npm run lint && npm run typecheck && npm run build && npm run check:html",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "husky",
    "validate:encoding": "node scripts/validate-encoding.cjs"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@vercel/speed-insights": "^1.3.1",
    "firebase": "^12.7.0",
    "framer-motion": "^12.36.0",
    "fuse.js": "^7.1.0",
    "leaflet": "^1.9.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.69.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.22.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "html-validate": "^10.5.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse": "^13.0.1",
    "lint-staged": "^17.0.7",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "terser": "^5.46.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.3.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,html,md}": [
      "prettier --write"
    ]
  }
}
