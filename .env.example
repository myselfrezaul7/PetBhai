# Firebase Configuration (Required for Google Sign-In)
# Get these from your Firebase Console -> Project Settings -> General -> Your apps
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Backend API URL (Optional, defaults to /api)
VITE_API_URL=/api

# Site URL (Used for SEO canonical/OG tags)
VITE_SITE_URL=https://www.petbhai.com/

# Google reCAPTCHA v2 Site Key (Required for login/signup)
# Get from: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Google reCAPTCHA Enterprise Site Key (Required for App Check security)
# Get from: Firebase Console -> App Check -> Apps -> Register web app
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_enterprise_site_key

# AI Configuration (Optional)
VITE_AI_PROXY_URL=
